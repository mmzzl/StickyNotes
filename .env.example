# ============================================================
# StickyNotes 便签应用 配置文件
# 复制为 .env 后按需修改；环境变量优先
# 服务端口统一 18000，由 start.sh 的 PORT 控制（不在此文件）
#
# 公开部署前生成两个**互不相同**的独立密钥：
#   python -c "import secrets; print(secrets.token_hex(32))"   → JWT_SECRET
#   python -c "import secrets; print(secrets.token_hex(32))"   → DATA_ENCRYPTION_KEY
# 前者签名令牌，后者加密通知渠道密码；分开后轮换任一密钥不影响另一处数据。
# ============================================================

# ---------- 应用基础 ----------
APP_NAME = StickyNotes 便签应用
API_PREFIX = /api/v1
DEBUG = false                 # 只影响日志细节/热重载，不再打开全量 SQL 回显
ECHO_SQL = false              # 排查 SQL 时才临时置 true
STARTUP_LEGACY = false        # 仅性能对照用：true 回退到旧启动行为，生产保持 false
CORS_ORIGINS = http://localhost:18000,http://127.0.0.1:18000

# production 时若密钥仍是默认值/弱值，服务拒绝启动；development 只告警
APP_ENV = development
# 也可单独强制校验（无论 APP_ENV 取值）
REQUIRE_SECURE_SECRETS = false
# 通知渠道敏感字段的独立加密密钥。留空时沿用历史派生方式并告警，
# 但已按「先新密钥、后旧派生」顺序解密，旧配置升级不会丢历史密文。
DATA_ENCRYPTION_KEY =

# ---------- 认证方式 (jwt | session) ----------
AUTH_MODE = jwt

# ---------- JWT 认证配置（AUTH_MODE=jwt 时生效）----------
JWT_SECRET = change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM = HS256
JWT_ACCESS_EXPIRE_MINUTES = 30
JWT_REFRESH_EXPIRE_DAYS = 7

# ---------- 注册与接口限流 ----------
# 关闭后不再开放自助注册（只由管理员建号）
REGISTER_ENABLED = true
# 新用户默认角色：user 仅 note:*。设为 admin 会让匿名注册者获得管理后台
# 读权限与通知渠道写权限，等价于提权漏洞，生产禁用。
REGISTER_DEFAULT_ROLE = user
# 进程内滑动窗口限流（单 worker 部署）；多副本请在网关 / Redis 侧做全局限流
RATE_LIMIT_ENABLED = true
RATE_LIMIT_PER_MINUTE = 30

# ---------- Session 认证配置（AUTH_MODE=session 时生效）----------
SESSION_EXPIRE_HOURS = 8
SESSION_COOKIE_NAME = session_id
SESSION_COOKIE_SECURE = false
SESSION_COOKIE_HTTPONLY = true

# ---------- 数据库（sqlite | mongodb）----------
DB_BACKEND = sqlite
# sqlite 后端：留空即用 config.py 的绝对路径（项目根 data/app.db）。
# 若要自定义，务必写绝对路径——相对路径会按「启动时的工作目录」解析，容易换库。
# DATABASE_URL = sqlite+aiosqlite:///C:/path/to/StickyNotes/data/app.db
# 表结构由 alembic 管理，启动时会按版本自动同步：
#   全新库 → 执行 migrations/ 建表；改造前的老库 → 补历史列并 stamp 基线
# 手动运维（需先停服务，DATABASE_URL 要与 .env 一致）：
#   alembic current / alembic check / alembic upgrade head
# 新增字段的标准流程见 README「数据库迁移」。SQLite 保持单 worker，
# 避免多个进程同时抢迁移锁。
MONGO_URI = mongodb://localhost:27017
MONGO_DB = app_template

# ---------- 验证码（登录防爆破）----------
CAPTCHA_ENABLED = true
CAPTCHA_LENGTH = 4
CAPTCHA_EXPIRE_SECONDS = 300

# ---------- 账户锁定（暴力破解防护）----------
LOGIN_MAX_FAILURES = 5
CAPTCHA_MAX_FAILURES = 3
LOCK_SECONDS = 300
# 默认 false：直连部署时 X-Forwarded-For 可随意伪造，会同时绕过账户锁定
# 与接口限流。只有确认 Nginx 等可信代理会**覆盖**该头时才置 true。
LOCK_TRUST_PROXY = false

# ---------- 密码策略 ----------
PASSWORD_MIN_LENGTH = 8
PASSWORD_REQUIRE_UPPER = true
PASSWORD_REQUIRE_LOWER = true
PASSWORD_REQUIRE_DIGIT = true
PASSWORD_REQUIRE_SPECIAL = false
PASSWORD_EXPIRE_DAYS = 90
PASSWORD_EXPIRE_WARNING_DAYS = 7
PASSWORD_HISTORY_COUNT = 5

# ---------- 日志 ----------
LOG_LEVEL = INFO
LOG_DIR = ../data/logs

# ---------- 定时任务 ----------
# SCHEDULE_CONF =
SCHEDULE_ENABLED = true

# ---------- 部署（systemd 安装使用）----------
SERVICE_USER = admin
SERVICE_GROUP = admin
