# ============================================================
# FastAPI 开箱即用模板 配置文件
# 复制为 .env 后按需修改；或通过环境变量覆盖（环境变量优先）
# ============================================================

# ---------- 应用基础 ----------
APP_NAME = 便签应用
API_PREFIX = /api/v1
DEBUG = true

# ---------- 认证方式 (jwt | session) ----------
AUTH_MODE = jwt

# ---------- JWT 认证配置（AUTH_MODE=jwt 时生效）----------
JWT_SECRET = change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM = HS256
JWT_ACCESS_EXPIRE_MINUTES = 10080
JWT_REFRESH_EXPIRE_DAYS = 7

# ---------- Session 认证配置（AUTH_MODE=session 时生效）----------
# session 会话保存到的表名服务器端，客户端只拿一个 session_id（HttpOnly Cookie）
SESSION_EXPIRE_HOURS = 8
SESSION_COOKIE_NAME = session_id
SESSION_COOKIE_SECURE = false
SESSION_COOKIE_HTTPONLY = true

# ---------- 数据库（sqlite | mongodb）----------
DB_BACKEND = sqlite
# sqlite 后端：文件路径（相对 backend/ 或绝对路径）
DATABASE_URL = sqlite+aiosqlite:///../data/app.db
# mongodb 后端：完整连接串；未配置启用 mongodb 会报错
MONGO_URI = mongodb://localhost:27017
MONGO_DB = app_template

# ---------- 日志 ----------
LOG_LEVEL = INFO
LOG_DIR = ../data/logs

# ---------- 定时任务（参考产品 inputs.conf 风格）----------
# 定时任务声明的配置文件路径（相对 backend/）
# SCHEDULE_CONF =
SCHEDULE_ENABLED = true

# ---------- 部署（systemd 安装使用）----------
# 服务运行用户（install.sh 会写入 systemd unit）
SERVICE_USER = admin
SERVICE_GROUP = admin
